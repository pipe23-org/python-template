version: 2

build:
  os: ubuntu-24.04
  tools:
    python: "3.13"
  commands:
    - pip install uv
[% if web_service %]    # full sync: the docs build imports the app to dump its OpenAPI schema
    - uv sync --locked
[% else %]    - uv sync --locked --no-install-project --only-group docs
[% endif %]    - uv run --no-sync mkdocs build --strict -d "$READTHEDOCS_OUTPUT/html"
