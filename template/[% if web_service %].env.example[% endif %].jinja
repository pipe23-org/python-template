# Copy to .env and fill in. .env is gitignored — never commit real secrets.
# Config env vars are prefixed [[ module_name | upper ]]_ and use __ between
# nesting levels: [[ module_name | upper ]]_SECTION__KEY overrides that scalar.
# LOG_FORMAT=console  # pretty dev logs; default is JSON lines
[% if database == "postgres" %]POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app
[[ module_name | upper ]]_APP__DATABASE_URL=postgresql+asyncpg://app:change-me@db:5432/app
[% elif database == "sqlite" %][[ module_name | upper ]]_APP__DATABASE_URL=sqlite+aiosqlite:///./app.db
[% endif %]
# Secrets convention: once SOPS + age is adopted, keep an encrypted `.env.enc`
# committed and decrypt to `.env` at deploy — so secrets version with the repo
# without ever being in plaintext in git.
