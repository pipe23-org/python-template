name: CI

on:
  push:
    branches: ['**']
  pull_request:
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: ci-${{ github.ref }}-${{ github.event_name }}
  cancel-in-progress: true

jobs:
  lint:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7
      - uses: astral-sh/setup-uv@v8.2.0
        with:
          python-version: "[[ python_min ]]"
      - run: uv sync --locked --no-install-project
      - run: uv run --no-sync ruff check
      - run: uv run --no-sync ruff format --check

  types:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7
[% if native_extension %]        with:
          submodules: recursive
      - run: sudo apt-get update && sudo apt-get install -y libssl-dev libzstd-dev libgtest-dev libbenchmark-dev
[% endif %]      - uses: astral-sh/setup-uv@v8.2.0
        with:
          python-version: "[[ python_min ]]"
      - run: uv sync --locked
      - run: uv run --no-sync mypy

  docs:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7
      - uses: astral-sh/setup-uv@v8.2.0
        with:
          python-version: "[[ python_min ]]"
[% if web_service %]      # full sync: the docs build imports the app to dump its OpenAPI schema
      - run: uv sync --locked
[% else %]      - run: uv sync --locked --no-install-project --only-group docs
[% endif %]      - run: uv run --no-sync interrogate -v src/[[ module_name ]]
      - run: uv run --no-sync mkdocs build --strict

  test-fast:
    if: ${{ github.event_name == 'push' && github.ref != 'refs/heads/main' }}
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7
[% if native_extension %]        with:
          submodules: recursive
      - run: sudo apt-get update && sudo apt-get install -y libssl-dev libzstd-dev libgtest-dev libbenchmark-dev
[% endif %]      - uses: astral-sh/setup-uv@v8.2.0
        with:
          python-version: "[[ python_min ]]"
      - run: uv sync --locked
      - run: uv run --no-sync pytest

  test:
    if: ${{ github.event_name == 'pull_request' || github.ref == 'refs/heads/main' }}
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        python-version: [[ ['3.11', '3.12', '3.13', '3.14'] | select('ge', python_min) | list | tojson ]]
    steps:
      - uses: actions/checkout@v7
[% if native_extension %]        with:
          submodules: recursive
      - run: sudo apt-get update && sudo apt-get install -y libssl-dev libzstd-dev libgtest-dev libbenchmark-dev
[% endif %]      - uses: astral-sh/setup-uv@v8.2.0
        with:
          python-version: ${{ matrix.python-version }}
      - run: uv sync --locked
      - run: uv run --no-sync pytest --cov
